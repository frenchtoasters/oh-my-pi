{
	"type": "module",
	"name": "@oh-my-pi/pi-insights",
	"version": "14.7.3",
	"description": "Personal usage insights report generated from your Pi session history",
	"homepage": "https://github.com/can1357/oh-my-pi",
	"author": "Hari Srinivasan <harisrini21@gmail.com>",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/pi-insights"
	},
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"keywords": [
		"insights",
		"usage-analytics",
		"agent",
		"extension"
	],
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@oh-my-pi/pi-ai": "workspace:*",
		"@oh-my-pi/pi-coding-agent": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13"
	},
	"engines": {
		"bun": ">=1.3.7"
	},
	"omp": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"exports": {
		".": {
			"types": "./src/extension.ts",
			"import": "./src/extension.ts"
		}
	},
	"files": [
		"src",
		"README.md"
	]
}