{
	"type": "module",
	"name": "@oh-my-pi/pi-usage",
	"version": "0.3.2",
	"description": "Usage statistics dashboard for Pi sessions.",
	"homepage": "https://github.com/tmustier/pi-extensions/tree/main/usage-extension",
	"author": "Thomas Mustier",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tmustier/pi-extensions.git",
		"directory": "usage-extension"
	},
	"bugs": {
		"url": "https://github.com/tmustier/pi-extensions/issues"
	},
	"keywords": [
		"usage",
		"usage-analytics",
		"agent",
		"extension"
	],
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*",
		"@oh-my-pi/pi-tui": "workspace:*",
		"@oh-my-pi/pi-utils": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13"
	},
	"engines": {
		"bun": ">=1.3.7"
	},
	"omp": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"exports": {
		".": {
			"types": "./src/extension.ts",
			"import": "./src/extension.ts"
		}
	},
	"files": [
		"src",
		"README.md"
	]
}